# Пример переменных окружения для MCP-сервера tc1c.
# Скопируйте в .env (или задайте в окружении процесса). Значения ниже — по умолчанию.

# Режим записи сценариев (tc_record_start/tc_record_finish):
#   synth  — (ПО УМОЛЧАНИЮ) сервер сам собирает сценарий из вызовов инструментов
#            (пишутся ВСЕ действия агента, включая те, что нативный журнал опускает, напр. setOrder);
#   native — журнал действий самого клиента 1С (только реальные UI-события; часть операций,
#            напр. сортировка колонок, платформой НЕ фиксируется). Указать явно при необходимости.
# Управляется окружением, а НЕ агентом (стабильность поведения). Пусто/не задано => synth.
TC1C_RECORD_MODE=synth

# Целевая версия платформы 1С (напр. 8.3.24.1548).
# Если задана: инструменты, чей метод в этой версии ещё не существует, не регистрируются,
# и эта версия используется по умолчанию в рукопожатии тест-клиента.
# Пусто = без ограничений (текущая версия по умолчанию).
# TC_PLATFORM_VERSION=

# Путь к 1cv8.exe для запуска тест-клиента инструментом tc_launch_client.
# Если не задан — берётся из стандартного пути установки (C:\Program Files\1cv8\<версия>\bin\1cv8.exe).
# TC1C_PLATFORM_EXE=C:\Program Files\1cv8\8.3.27.1859\bin\1cv8.exe

# Формат ответов MCP: toon (по умолчанию) | json.
#   toon — компактный вывод для LLM: ответы сериализуются в TOON;
#   json — обычный JSON. Представление адресов задаёт TC1C_COMPACT_REFS.
TC1C_RESPONSE_FORMAT=toon

# Адреса элементов:
#   id (по умолчанию) — короткий ref вместо key/handle; работает с TOON и JSON;
#   prefix — прежние @p:N/@h:N со словарями, агент разворачивает их; только для TOON;
#   off — полные key/handle. true и false сохранены как синонимы prefix и off.
TC1C_COMPACT_REFS=id

# Максимум элементов в реестре одного подключения; положительное целое число.
# Повторные элементы переиспользуются, давно не использовавшиеся вытесняются.
# Ограничивает также кэш key/handle в режимах prefix и off. Это число записей, не байты.
TC1C_REF_LIMIT=100000

# Хранилище состояний форм: максимум снимков и объём памяти в МиБ на весь сервер.
# Положительные целые числа; при переполнении вытесняются давно не использовавшиеся снимки.
TC1C_SNAPSHOT_LIMIT=100
TC1C_SNAPSHOT_MEMORY_MB=128

# Предполётная проверка существования объекта перед мутирующим действием:
#   true (по умолчанию) — перед действием уходит один read-кадр по тому же адресу. Если объекта
#     нет, действие НЕ отправляется и возвращается ошибка; иначе в ответ добавляется
#     target_check = present | unknown (проверка недоступна по версии или типу — действие
#     при этом выполняется);
#   false — проверка не выполняется, в ответе target_check = off.
# Кадр действия признака ошибки не несёт, поэтому без этой проверки опечатка в адресе
# неотличима от успешного действия.
TC1C_VERIFY_TARGET=true

# Наблюдение состояния до и после мутирующего действия:
#   true (по умолчанию) — перед действием и после него читается наблюдаемое свойство, в ответ
#     идут observed (что наблюдали), changed и value_before/value_after. changed=true доказывает
#     эффект; changed=false означает лишь, что наблюдение не изменилось;
#   false — наблюдение не снимается, в ответе changed=null и readback=off.
TC1C_READBACK=true

# Снимки окна 1С: true (по умолчанию) | false.
# При false действие get_screenshot и его параметры не публикуются в tc_app.
TC1C_SCREENSHOTS=true

# Транспорт MCP: stdio (по умолчанию) | streamable-http | sse.
TC1C_TRANSPORT=stdio
# Максимум зарегистрированных клиентов; реестр ссылок ограничен отдельно для каждого.
TC1C_CONNECTION_LIMIT=16
# Параметры HTTP-транспорта (streamable-http/sse):
TC1C_HTTP_HOST=127.0.0.1
TC1C_HTTP_PORT=6004
# Путь эндпоинта — ТОЛЬКО для streamable-http. У sse пути стандартные (/sse и /messages/).
TC1C_HTTP_PATH=/mcp
