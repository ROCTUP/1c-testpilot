// Запускается на открытой форме со списком «Список».
СтандартнаяОбработка = Ложь;

Форма = Здесь();
Таблица = Форма.ПолучитьОбъект(Тип("ТестируемаяТаблицаФормы"), , "Список");
Поля = Таблица.НайтиОбъекты(Тип("ТестируемоеПолеФормы"));

Для Каждого Поле Из Поля Цикл
    Заявить(Поле.Имя).Заполнено();
    Заявить(Поле.ПолучитьРодителя()).Существует();
КонецЦикла;

Возврат Поля.Количество();
