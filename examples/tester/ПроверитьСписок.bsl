// Параметры _: Ссылка, Таблица (имя элемента), Повторы, МинимумСтрок.
// Читает список, проверяет количество строк и возвращает итог.
СтандартнаяОбработка = Ложь;
Коммандос(_.Ссылка);
таблица = Получить("!" + _.Таблица);
количества = Новый Массив;
Для i = 1 По _.Повторы Цикл
    количество = Вызвать("ПодсчитатьСтроки", таблица);
    Заявить(количество, "В списке недостаточно строк").БольшеИлиРавно(_.МинимумСтрок);
    количества.Добавить(количество);
КонецЦикла;
Возврат Новый Структура("Количество,Повторы,Всего", количество, количества.Количество(), сумма(количества));

Функция сумма(числа)
    результат = 0;
    Для Каждого число Из числа Цикл
        результат = результат + число;
    КонецЦикла;
    Возврат результат;
КонецФункции
