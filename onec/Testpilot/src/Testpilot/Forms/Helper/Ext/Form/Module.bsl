#Область ПрограммныйИнтерфейс

// Регистрирует только явно перечисленные функции. Имя обработчика агенту не передается.
// Обработчик принимает один аргумент Параметры (Соответствие) и возвращает значение.
&НаКлиентеНаСервереБезКонтекста
Процедура ЗарегистрироватьПользовательскуюФункцию(Реестр, Имя, Описание, Контекст, Обработчик, Аргументы, ОписаниеРезультата = "")
    Реестр.Добавить(Новый Структура("name,description,context,handler,parameters,result_description",
        Имя, Описание, Контекст, Обработчик, Аргументы, ОписаниеРезультата));
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ОписаниеПараметраФункции(Имя, Вид = "any", Описание = "", Обязательный = Ложь, ЗначениеПоУмолчанию = Неопределено)
    ОписаниеПараметра = Новый Структура("name,type,description,required", Имя, Вид, Описание, Обязательный);
    Если ЗначениеПоУмолчанию <> Неопределено Тогда
        ОписаниеПараметра.Вставить("default", ЗначениеПоУмолчанию);
    КонецЕсли;
    Возврат ОписаниеПараметра;
КонецФункции

#КонецОбласти

#Область ПолучениеМетаданных

&НаСервереБезКонтекста
Функция ПолучитьМетаданныеПривилегированно(Отбор)
    ИсходныйРежим = ПривилегированныйРежим();
    Попытка
        Если Не ИсходныйРежим Тогда УстановитьПривилегированныйРежим(Истина); КонецЕсли;
        // Безопасный режим может игнорировать повышение прав. Само описание метаданных
        // при этом доступно; ошибки чтения отдельных сведений собираются в errors.
        Результат = ПрочитатьМетаданные(Отбор);
    Исключение
        Если Не ИсходныйРежим Тогда УстановитьПривилегированныйРежим(Ложь); КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;
    Если Не ИсходныйРежим Тогда УстановитьПривилегированныйРежим(Ложь); КонецЕсли;
    Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ВидыМетаданных()
    // Только эти внутренние имена участвуют в Вычислить(). Текст запроса агента туда не попадает.
    Возврат СтрРазделить("Справочник:Справочники,Документ:Документы,Перечисление:Перечисления,"
        + "РегистрСведений:РегистрыСведений,РегистрНакопления:РегистрыНакопления,"
        + "РегистрБухгалтерии:РегистрыБухгалтерии,РегистрРасчета:РегистрыРасчета,"
        + "ПланВидовХарактеристик:ПланыВидовХарактеристик,ПланСчетов:ПланыСчетов,"
        + "ПланВидовРасчета:ПланыВидовРасчета,ПланОбмена:ПланыОбмена,"
        + "БизнесПроцесс:БизнесПроцессы,Задача:Задачи,Константа:Константы,"
        + "ЖурналДокументов:ЖурналыДокументов,Последовательность:Последовательности,"
        + "ОпределяемыйТип:ОпределяемыеТипы,ОбщийРеквизит:ОбщиеРеквизиты,"
        + "Отчет:Отчеты,Обработка:Обработки,ОбщаяФорма:ОбщиеФормы,"
        + "ОбщийМодуль:ОбщиеМодули,Роль:Роли,Подсистема:Подсистемы", ",");
КонецФункции

&НаСервереБезКонтекста
Функция ПрочитатьСвойствоМетаданных(Мета, Свойство)
    // Свойство всегда из фиксированных списков стандартного кода обработки.
    Возврат Вычислить("Мета." + Свойство);
КонецФункции

&НаСервереБезКонтекста
Функция КраткоеОписаниеМетаданных(Мета, ПолноеИмя = "")
    ЧастиИмени = СтрРазделить(ПолноеИмя, ".");
    Если ЧастиИмени.Количество() >= 4 И НРег(ЧастиИмени[ЧастиИмени.Количество() - 2]) = "стандартныйреквизит" Тогда
        ЧастиИмени.Удалить(ЧастиИмени.Количество() - 1);
        ЧастиИмени.Удалить(ЧастиИмени.Количество() - 1);
        Родитель = Метаданные.НайтиПоПолномуИмени(СтрСоединить(ЧастиИмени, "."));
        ПолноеИмя = Родитель.ПолноеИмя() + ".СтандартныйРеквизит." + Мета.Имя;
    Иначе
        ПолноеИмя = Мета.ПолноеИмя();
    КонецЕсли;
    Возврат Новый Структура("name,title", ПолноеИмя, Мета.Синоним);
КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьОшибкуМетаданных(Ошибки, Имя, Сообщение)
    Ошибки.Добавить(Новый Структура("name,error", Имя, Сообщение));
КонецПроцедуры

&НаСервереБезКонтекста
Функция СоответствуетПоискуМетаданных(Знач Имя, Заголовок, Поиск, ТолькоИмяПоля = Ложь)
    Если ТолькоИмяПоля Тогда
        Части = СтрРазделить(Имя, ".");
        Имя = Части[Части.Количество() - 1];
    КонецЕсли;
    Возврат ПустаяСтрока(Поиск) Или СтрНайти(НРег(Имя + " " + Заголовок), НРег(Поиск)) > 0;
КонецФункции

&НаСервереБезКонтекста
Функция КоллекцииПолейМетаданных(Вид)
    Коллекции = "";
    Если СтрРазделить("Справочник,Документ,ПланВидовХарактеристик,ПланСчетов,ПланВидовРасчета,ПланОбмена,БизнесПроцесс,Задача", ",").Найти(Вид) <> Неопределено Тогда
        Коллекции = "СтандартныеРеквизиты,Реквизиты";
    ИначеЕсли СтрРазделить("РегистрСведений,РегистрНакопления,РегистрБухгалтерии,РегистрРасчета", ",").Найти(Вид) <> Неопределено Тогда
        Коллекции = "СтандартныеРеквизиты,Измерения,Ресурсы,Реквизиты";
    ИначеЕсли Вид = "ТабличнаяЧасть" Тогда
        Коллекции = "СтандартныеРеквизиты,Реквизиты";
    ИначеЕсли Вид = "ЖурналДокументов" Тогда
        Коллекции = "СтандартныеРеквизиты,Графы";
    ИначеЕсли Вид = "Последовательность" Тогда
        Коллекции = "Измерения";
    ИначеЕсли Вид = "Обработка" Или Вид = "Отчет" Тогда
        Коллекции = "Реквизиты";
    КонецЕсли;
    Возврат СтрРазделить(Коллекции, ",", Ложь);
КонецФункции

&НаСервереБезКонтекста
Функция ОписаниеТиповМетаданных(Описание)
    Результат = Новый Массив;
    Для Каждого Вид Из Описание.Типы() Цикл
        СтрокаТипа = Новый Структура("type,metadata,qualifiers", Строка(Вид), "", Новый Структура);
        Мета = Метаданные.НайтиПоТипу(Вид);
        Если Мета <> Неопределено Тогда СтрокаТипа.metadata = Мета.ПолноеИмя(); КонецЕсли;
        Если Вид = Тип("Строка") Тогда
            Кв = Описание.КвалификаторыСтроки;
            СтрокаТипа.qualifiers = Новый Структура("length,allowed_length", Кв.Длина, Строка(Кв.ДопустимаяДлина));
        ИначеЕсли Вид = Тип("Число") Тогда
            Кв = Описание.КвалификаторыЧисла;
            СтрокаТипа.qualifiers = Новый Структура("digits,fraction_digits,allowed_sign", Кв.Разрядность, Кв.РазрядностьДробнойЧасти, Строка(Кв.ДопустимыйЗнак));
        ИначеЕсли Вид = Тип("Дата") Тогда
            СтрокаТипа.qualifiers = Новый Структура("date_fractions", Строка(Описание.КвалификаторыДаты.ЧастиДаты));
        КонецЕсли;
        Результат.Добавить(СтрокаТипа);
    КонецЦикла;
    Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ОписаниеПоляМетаданных(Мета, Вид, Типы, Имя = "")
    Если ПустаяСтрока(Имя) Тогда Имя = Мета.ПолноеИмя(); КонецЕсли;
    Если Вид = "Графы" Или Вид = "Графа" Тогда
        Виды = Новый Массив;
        Представления = Новый Массив;
        Для Каждого Реквизит Из Мета.Ссылки Цикл
            Для Каждого СтрокаТипа Из ОписаниеТиповМетаданных(Реквизит.Тип) Цикл
                Виды.Добавить(СтрокаТипа);
                Если Представления.Найти(СтрокаТипа.type) = Неопределено Тогда Представления.Добавить(СтрокаТипа.type); КонецЕсли;
            КонецЦикла;
        КонецЦикла;
        Типы.Вставить(Имя, Виды);
        Возврат Новый Структура("name,title,kind,type", Имя, Мета.Синоним, Вид, СтрСоединить(Представления, ", "));
    КонецЕсли;
    Описание = Мета.Тип;
    Типы.Вставить(Имя, ОписаниеТиповМетаданных(Описание));
    Возврат Новый Структура("name,title,kind,type", Имя, Мета.Синоним, Вид, Строка(Описание));
КонецФункции

&НаСервереБезКонтекста
Функция ПрочитатьПоляМетаданных(Мета, Вид, Типы, Ошибки)
    Результат = Новый Массив;
    Для Каждого Коллекция Из КоллекцииПолейМетаданных(Вид) Цикл
        Попытка
            Для Каждого Поле Из ПрочитатьСвойствоМетаданных(Мета, Коллекция) Цикл
                Попытка
                    ИмяПоля = "";
                    Если Коллекция = "СтандартныеРеквизиты" Тогда
                        ИмяПоля = Мета.ПолноеИмя() + ".СтандартныйРеквизит." + Поле.Имя;
                    КонецЕсли;
                    Результат.Добавить(ОписаниеПоляМетаданных(Поле, Коллекция, Типы, ИмяПоля));
                Исключение
                    ДобавитьОшибкуМетаданных(Ошибки, Мета.ПолноеИмя() + "." + Коллекция + "." + Поле.Имя, ОписаниеОшибки());
                КонецПопытки;
            КонецЦикла;
        Исключение
            ДобавитьОшибкуМетаданных(Ошибки, Мета.ПолноеИмя() + "." + Коллекция, ОписаниеОшибки());
        КонецПопытки;
    КонецЦикла;
    Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ПодробноеОписаниеМетаданных(Мета, Секции, Типы, Ошибки, ПолноеИмя = "")
    Ответ = КраткоеОписаниеМетаданных(Мета, ПолноеИмя);
    Части = СтрРазделить(Ответ.name, ".");
    Вид = Части[0];
    Если Части.Количество() > 2 Тогда Вид = Части[Части.Количество() - 2]; КонецЕсли;
    Если СтрРазделить("Реквизит,СтандартныйРеквизит,Измерение,Ресурс,Графа,Константа,ОбщийРеквизит,ОпределяемыйТип", ",").Найти(Вид) <> Неопределено Тогда
        Ответ.Вставить("fields", Новый Массив);
        Ответ.fields.Добавить(ОписаниеПоляМетаданных(Мета, Вид, Типы, Ответ.name));
        Возврат Ответ;
    КонецЕсли;
    Если Секции.Найти("fields") <> Неопределено Тогда
        Ответ.Вставить("fields", ПрочитатьПоляМетаданных(Мета, Вид, Типы, Ошибки));
    КонецЕсли;
    Если Секции.Найти("table_parts") <> Неопределено И
        СтрРазделить("Справочник,Документ,ПланВидовХарактеристик,ПланСчетов,ПланВидовРасчета,ПланОбмена,БизнесПроцесс,Задача,Обработка,Отчет", ",").Найти(Вид) <> Неопределено Тогда
        ЧастиТаблицы = Новый Массив;
        Попытка
            Для Каждого ТЧ Из Мета.ТабличныеЧасти Цикл
                СтрокаТЧ = КраткоеОписаниеМетаданных(ТЧ);
                СтрокаТЧ.Вставить("fields", ПрочитатьПоляМетаданных(ТЧ, "ТабличнаяЧасть", Типы, Ошибки));
                ЧастиТаблицы.Добавить(СтрокаТЧ);
            КонецЦикла;
        Исключение
            ДобавитьОшибкуМетаданных(Ошибки, Мета.ПолноеИмя() + ".ТабличныеЧасти", ОписаниеОшибки());
        КонецПопытки;
        Ответ.Вставить("table_parts", ЧастиТаблицы);
    КонецЕсли;
    Если Секции.Найти("values") <> Неопределено И Вид = "Перечисление" Тогда
        Значения = Новый Массив;
        Для Каждого Элемент Из Мета.ЗначенияПеречисления Цикл Значения.Добавить(КраткоеОписаниеМетаданных(Элемент)); КонецЦикла;
        Ответ.Вставить("values", Значения);
    КонецЕсли;
    Если Секции.Найти("properties") <> Неопределено Тогда
        Свойства = Новый Структура;
        ИменаСвойств = "";
        Если Вид = "Справочник" Тогда ИменаСвойств = "Иерархический,ВидИерархии,ДлинаКода,ДлинаНаименования,ТипКода";
        ИначеЕсли Вид = "Документ" Тогда ИменаСвойств = "Проведение,ДлинаНомера,ТипНомера,ПериодичностьНомера";
        ИначеЕсли Вид = "РегистрСведений" Тогда ИменаСвойств = "ПериодичностьРегистраСведений,РежимЗаписи";
        ИначеЕсли Вид = "РегистрНакопления" Тогда ИменаСвойств = "ВидРегистра";
        КонецЕсли;
        Для Каждого ИмяСвойства Из СтрРазделить(ИменаСвойств, ",", Ложь) Цикл
            Попытка
                Значение = ПрочитатьСвойствоМетаданных(Мета, ИмяСвойства);
                Если ТипЗнч(Значение) <> Тип("Булево") И ТипЗнч(Значение) <> Тип("Число") Тогда Значение = Строка(Значение); КонецЕсли;
                Свойства.Вставить(ИмяСвойства, Значение);
            Исключение
                ДобавитьОшибкуМетаданных(Ошибки, Мета.ПолноеИмя() + "." + ИмяСвойства, ОписаниеОшибки());
            КонецПопытки;
        КонецЦикла;
        Ответ.Вставить("properties", Свойства);
    КонецЕсли;
    Возврат Ответ;
КонецФункции

&НаСервереБезКонтекста
Функция НайтиМетаданные(Имя)
    Мета = Метаданные.НайтиПоПолномуИмени(Имя);
    Если Мета <> Неопределено Тогда Возврат Мета; КонецЕсли;
    Части = СтрРазделить(Имя, ".");
    Если Части.Количество() < 4 Или Части.Количество() % 2 <> 0 Тогда Возврат Неопределено; КонецЕсли;
    Мета = Метаданные.НайтиПоПолномуИмени(Части[0] + "." + Части[1]);
    Коллекции = Новый Соответствие;
    Для Каждого Пара Из СтрРазделить("Реквизит:Реквизиты,СтандартныйРеквизит:СтандартныеРеквизиты,ТабличнаяЧасть:ТабличныеЧасти,Измерение:Измерения,Ресурс:Ресурсы,ЗначениеПеречисления:ЗначенияПеречисления,Графа:Графы", ",") Цикл
        КлючЗначение = СтрРазделить(Пара, ":");
        Коллекции.Вставить(НРег(КлючЗначение[0]), КлючЗначение[1]);
    КонецЦикла;
    Индекс = 2;
    Пока Мета <> Неопределено И Индекс < Части.Количество() Цикл
        Коллекция = Коллекции[НРег(Части[Индекс])];
        Если Коллекция = Неопределено Тогда Возврат Неопределено; КонецЕсли;
        Найденный = Неопределено;
        Для Каждого Элемент Из ПрочитатьСвойствоМетаданных(Мета, Коллекция) Цикл
            Если НРег(Элемент.Имя) = НРег(Части[Индекс + 1]) Тогда
                Найденный = Элемент;
                Прервать;
            КонецЕсли;
        КонецЦикла;
        Мета = Найденный;
        Индекс = Индекс + 2;
    КонецЦикла;
    Возврат Мета;
КонецФункции

&НаСервереБезКонтекста
Функция СтраницаМетаданных(Строки, Отбор)
    Сортировка = Новый ТаблицаЗначений;
    Сортировка.Колонки.Добавить("name");
    Сортировка.Колонки.Добавить("item");
    Для Каждого Элемент Из Строки Цикл
        СтрокаТаблицы = Сортировка.Добавить();
        СтрокаТаблицы.name = Элемент.name;
        СтрокаТаблицы.item = Элемент;
    КонецЦикла;
    Сортировка.Сортировать("name");
    Результат = Новый Массив;
    Для Индекс = Отбор["offset"] По Мин(Сортировка.Количество(), Отбор["offset"] + Отбор["limit"]) - 1 Цикл
        Результат.Добавить(Сортировка[Индекс].item);
    КонецЦикла;
    Возврат Новый Структура("items,total,offset,limit,returned,truncated", Результат, Строки.Количество(),
        Отбор["offset"], Отбор["limit"], Результат.Количество(), Отбор["offset"] + Результат.Количество() < Строки.Количество());
КонецФункции

&НаСервереБезКонтекста
Функция ПрочитатьМетаданные(Отбор)
    Ошибки = Новый Массив;
    Типы = Новый Соответствие;
    Если Не ПустаяСтрока(Отбор["name"]) Тогда
        Мета = НайтиМетаданные(Отбор["name"]);
        Если Мета = Неопределено Тогда
            Возврат Новый Структура("ok,code,error", Ложь, "metadata_not_found", "Metadata object not found: " + Отбор["name"]);
        КонецЕсли;
        Ответ = Новый Структура("ok,object,types,errors,complete", Истина, ПодробноеОписаниеМетаданных(Мета, Отбор["sections"], Типы, Ошибки, Отбор["name"]), Типы, Ошибки, Ошибки.Количество() = 0);
        Возврат Ответ;
    КонецЕсли;
    Обзор = ПустаяСтрока(Отбор["meta_type"]) И ПустаяСтрока(Отбор["search"]) И ПустаяСтрока(Отбор["field_search"]);
    Строки = Новый Массив;
    ВидНайден = ПустаяСтрока(Отбор["meta_type"]);
    Для Каждого ОписаниеВида Из ВидыМетаданных() Цикл
        ЧастиВида = СтрРазделить(ОписаниеВида, ":");
        Вид = ЧастиВида[0];
        Если Не ПустаяСтрока(Отбор["meta_type"]) И НРег(Отбор["meta_type"]) <> НРег(Вид) Тогда Продолжить; КонецЕсли;
        ВидНайден = Истина;
        Попытка
            Коллекция = ПрочитатьСвойствоМетаданных(Метаданные, ЧастиВида[1]);
            Если Обзор Тогда
                Строки.Добавить(Новый Структура("name,count", Вид, Коллекция.Количество()));
                Продолжить;
            КонецЕсли;
            Для Каждого Мета Из Коллекция Цикл
                Если Не СоответствуетПоискуМетаданных(Мета.ПолноеИмя(), Мета.Синоним, Отбор["search"]) Тогда Продолжить; КонецЕсли;
                Если ПустаяСтрока(Отбор["field_search"]) Тогда
                    Строки.Добавить(КраткоеОписаниеМетаданных(Мета));
                Иначе
                    Данные = ПодробноеОписаниеМетаданных(Мета, СтрРазделить("fields,table_parts", ","), Типы, Ошибки);
                    Если Данные.Свойство("fields") Тогда
                        Для Каждого Поле Из Данные.fields Цикл
                            Если СоответствуетПоискуМетаданных(Поле.name, Поле.title, Отбор["field_search"], Истина) Тогда Строки.Добавить(Поле); КонецЕсли;
                        КонецЦикла;
                    КонецЕсли;
                    Если Данные.Свойство("table_parts") Тогда
                        Для Каждого ТЧ Из Данные.table_parts Цикл
                            Для Каждого Поле Из ТЧ.fields Цикл
                                Если СоответствуетПоискуМетаданных(Поле.name, Поле.title, Отбор["field_search"], Истина) Тогда Строки.Добавить(Поле); КонецЕсли;
                            КонецЦикла;
                        КонецЦикла;
                    КонецЕсли;
                КонецЕсли;
            КонецЦикла;
        Исключение
            ДобавитьОшибкуМетаданных(Ошибки, Вид, ОписаниеОшибки());
        КонецПопытки;
    КонецЦикла;
    Если Не ВидНайден Тогда Возврат Новый Структура("ok,code,error", Ложь, "unknown_metadata_type", "Choose meta_type from the metadata overview."); КонецЕсли;
    Ответ = СтраницаМетаданных(Строки, Отбор);
    Если Обзор Тогда
        Ответ.Вставить("configuration", Новый Структура("name,title,version", Метаданные.Имя, Метаданные.Синоним, Метаданные.Версия));
    КонецЕсли;
    Если Не ПустаяСтрока(Отбор["field_search"]) Тогда
        ТипыСтраницы = Новый Соответствие;
        Для Каждого Поле Из Ответ.items Цикл ТипыСтраницы.Вставить(Поле.name, Типы[Поле.name]); КонецЦикла;
        Ответ.Вставить("types", ТипыСтраницы);
    КонецЕсли;
    Ответ.Вставить("ok", Истина);
    Ответ.Вставить("errors", Ошибки);
    Ответ.Вставить("complete", Ошибки.Количество() = 0);
    Возврат Ответ;
КонецФункции

#КонецОбласти

#Область ВызовПользовательскихФункций

&НаКлиентеНаСервереБезКонтекста
Функция ПроверенныйРеестрПользовательскихФункций()
    Реестр = РеестрПользовательскихФункций();
    Имена = Новый Соответствие;
    Для Каждого Описание Из Реестр Цикл
        Если Описание.context <> "client" И Описание.context <> "server" Тогда ВызватьИсключение "Invalid custom function context."; КонецЕсли;
        Если Имена[НРег(Описание.name)] <> Неопределено Тогда ВызватьИсключение "Duplicate custom function name."; КонецЕсли;
        Имена.Вставить(НРег(Описание.name), Истина);
        Для Каждого Имя Из СтрРазделить(Описание.name + "," + Описание.handler, ",") Цикл
            Если ПустаяСтрока(Имя) Тогда ВызватьИсключение "Empty custom function name or handler."; КонецЕсли;
            Для Индекс = 1 По СтрДлина(Имя) Цикл
                Символ = Сред(Имя, Индекс, 1);
                ЭтоБуква = НРег(Символ) <> ВРег(Символ) Или Символ = "_";
                ЭтоЦифра = СтрНайти("0123456789", Символ) > 0;
                Если Не ЭтоБуква И Не (Индекс > 1 И ЭтоЦифра) Тогда ВызватьИсключение "Custom function names and handlers must be identifiers."; КонецЕсли;
            КонецЦикла;
        КонецЦикла;
    КонецЦикла;
    Возврат Реестр;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОписанияПользовательскихФункций()
    Результат = Новый Массив;
    Для Каждого Описание Из ПроверенныйРеестрПользовательскихФункций() Цикл
        Результат.Добавить(Новый Структура("name,description,context,parameters,result_description",
            Описание.name, Описание.description, Описание.context, Описание.parameters, Описание.result_description));
    КонецЦикла;
    Возврат Результат;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НайтиПользовательскуюФункцию(Имя, Контекст)
    Для Каждого Описание Из ПроверенныйРеестрПользовательскихФункций() Цикл
        Если НРег(Описание.name) = НРег(Имя) Тогда
            Если Описание.context <> Контекст Тогда ВызватьИсключение "Custom function context mismatch."; КонецЕсли;
            Возврат Описание;
        КонецЕсли;
    КонецЦикла;
    ВызватьИсключение "Unknown custom BSL function.";
КонецФункции

&НаКлиенте
Функция ВыполнитьПользовательскуюФункциюНаКлиенте(Обработчик, Параметры)
    Результат = Неопределено;
    Выполнить("Результат = " + Обработчик + "(Параметры);");
    Возврат ПодготовитьЗначение(Результат);
КонецФункции

&НаСервере
Функция ВыполнитьПользовательскуюФункциюНаСервере(Обработчик, Параметры)
    Результат = Неопределено;
    Выполнить("Результат = " + Обработчик + "(Параметры);");
    Возврат ПодготовитьЗначение(Результат);
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Заголовок = "Testpilot";
    ClientDocument = Новый ФорматированныйДокумент;
    ServerDocument = Новый ФорматированныйДокумент;
    ClientResult = СформироватьJSON(Новый Структура("protocol,request_id,ok,status", 1, "", Истина, "ready"));
    ServerResult = ClientResult;
    Попытка
        ServiceInfo = СформироватьJSON(Новый Структура("protocol,request_id,ok,capabilities,functions", 1, "", Истина,
            СтрРазделить("metadata,custom_functions", ","), ОписанияПользовательскихФункций()));
    Исключение
        ServiceInfo = СформироватьОтветОбОшибке("", ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
    Отказ = Не ЗавершениеРаботы;
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьНаКлиенте(Команда)
    Идентификатор = "";
    Попытка
        Пакет = ПрочитатьПакетЗапроса(ClientDocument.ПолучитьТекст(), "client");
        Идентификатор = Пакет.request_id;
        Если Пакет.mode = "code" Тогда
            ЗначениеОтвета = ВыполнитьКодНаКлиенте(Пакет.code, ВосстановитьЗначениеОбмена(Пакет.parameters));
        ИначеЕсли Пакет.mode = "function" Тогда
            Описание = НайтиПользовательскуюФункцию(Пакет.name, "client");
            ЗначениеОтвета = ВыполнитьПользовательскуюФункциюНаКлиенте(Описание.handler, ВосстановитьЗначениеОбмена(Пакет.parameters));
        Иначе
            ВызватьИсключение "Unknown client execution mode.";
        КонецЕсли;
        ClientResult = СформироватьJSON(Новый Структура("protocol,request_id,ok,result", 1, Идентификатор, Истина, ЗначениеОтвета));
    Исключение
        ClientResult = СформироватьОтветОбОшибке(Идентификатор, ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьНаСервере(Команда)
    ОбработатьСерверныйЗапрос();
КонецПроцедуры

#КонецОбласти

#Область ОбменЗапросамиИРезультатами

&НаСервере
Процедура ОбработатьСерверныйЗапрос()
    Идентификатор = "";
    Попытка
        Пакет = ПрочитатьПакетЗапроса(ServerDocument.ПолучитьТекст(), "server");
        Идентификатор = Пакет.request_id;
        Аргументы = ВосстановитьЗначениеОбмена(Пакет.parameters);
        Если Пакет.mode = "query" Тогда
            Ответ = ВыполнитьЗапрос(Пакет.query, Аргументы, Пакет.limit);
            Ответ.Вставить("protocol", 1);
            Ответ.Вставить("request_id", Идентификатор);
            Ответ.Вставить("ok", Истина);
        ИначеЕсли Пакет.mode = "code" Тогда
            ЗначениеОтвета = ВыполнитьКодНаСервере(Пакет.code, Аргументы);
            Ответ = Новый Структура("protocol,request_id,ok,result", 1, Идентификатор, Истина, ЗначениеОтвета);
        ИначеЕсли Пакет.mode = "metadata" Тогда
            Ответ = ПолучитьМетаданныеПривилегированно(Пакет.options);
            Ответ.Вставить("protocol", 1);
            Ответ.Вставить("request_id", Идентификатор);
        ИначеЕсли Пакет.mode = "function" Тогда
            Описание = НайтиПользовательскуюФункцию(Пакет.name, "server");
            ЗначениеОтвета = ВыполнитьПользовательскуюФункциюНаСервере(Описание.handler, Аргументы);
            Ответ = Новый Структура("protocol,request_id,ok,result", 1, Идентификатор, Истина, ЗначениеОтвета);
        Иначе
            ВызватьИсключение "Unknown execution mode.";
        КонецЕсли;
        ServerResult = СформироватьJSON(Ответ);
    Исключение
        ServerResult = СформироватьОтветОбОшибке(Идентификатор, ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область ВыполнениеКодаИЗапросов

&НаКлиенте
Функция ВыполнитьКодНаКлиенте(Код, Параметры)
    Результат = Неопределено;
    Выполнить(Код);
    Возврат ПодготовитьЗначение(Результат);
КонецФункции

&НаСервере
Функция ВыполнитьКодНаСервере(Код, Параметры)
    Результат = Неопределено;
    Выполнить(Код);
    Возврат ПодготовитьЗначение(Результат);
КонецФункции

&НаСервереБезКонтекста
Функция ВыполнитьЗапрос(Текст, Параметры, Лимит)
    Если Лимит < 1 Или Лимит > 500 Или Лимит <> Цел(Лимит) Тогда
        ВызватьИсключение "limit must be 1..500.";
    КонецЕсли;
    Запрос = Новый Запрос(Текст);
    Для Каждого Пара Из Параметры Цикл
        Запрос.УстановитьПараметр(Пара.Ключ, Пара.Значение);
    КонецЦикла;
    Данные = Запрос.Выполнить();
    Колонки = Новый Массив;
    Для Каждого Колонка Из Данные.Колонки Цикл
        Колонки.Добавить(Колонка.Имя);
    КонецЦикла;
    Строки = Новый Массив;
    Выборка = Данные.Выбрать();
    Пока Строки.Количество() < Лимит И Выборка.Следующий() Цикл
        СтрокаРезультата = Новый Соответствие;
        Для Каждого Имя Из Колонки Цикл
            СтрокаРезультата.Вставить(Имя, ПодготовитьЗначение(Выборка[Имя]));
        КонецЦикла;
        Строки.Добавить(СтрокаРезультата);
    КонецЦикла;
    Усечен = Выборка.Следующий();
    Возврат Новый Структура("columns,rows,returned_rows,limit,truncated", Колонки, Строки, Строки.Количество(), Лимит, Усечен);
КонецФункции

#КонецОбласти

#Область ПреобразованиеЗначений

&НаКлиентеНаСервереБезКонтекста
Функция ПрочитатьПакетЗапроса(Текст, Контекст)
    Читатель = Новый ЧтениеJSON;
    Читатель.УстановитьСтроку(Текст);
    Карта = ПрочитатьJSON(Читатель, Истина);
    Читатель.Закрыть();
    Пакет = Новый Структура;
    Для Каждого Пара Из Карта Цикл
        Пакет.Вставить(Пара.Ключ, Пара.Значение);
    КонецЦикла;
    Если Пакет.protocol <> 1 Или Пакет.context <> Контекст Или ПустаяСтрока(Пакет.request_id) Тогда
        ВызватьИсключение "Incompatible Testpilot request.";
    КонецЕсли;
    Возврат Пакет;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СформироватьJSON(Значение)
    Писатель = Новый ЗаписьJSON;
    Писатель.УстановитьСтроку();
    ЗаписатьJSON(Писатель, Значение);
    Возврат Писатель.Закрыть();
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СформироватьОтветОбОшибке(Идентификатор, Сообщение)
    Возврат СформироватьJSON(Новый Структура("protocol,request_id,ok,code,error", 1, Идентификатор, Ложь, "execution_failed", Сообщение));
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВосстановитьЗначениеОбмена(Знач Значение)
    Вид = ТипЗнч(Значение);
    Если Вид = Тип("Структура") Или Вид = Тип("Соответствие") Тогда
        Тег = Неопределено;
        Для Каждого Пара Из Значение Цикл
            Если Пара.Ключ = "$type" Тогда Тег = Пара.Значение; КонецЕсли;
        КонецЦикла;
        Если Тег = "date" Тогда
            Возврат XMLЗначение(Тип("Дата"), Значение["value"]);
        ИначеЕсли Тег = "ref" Тогда
            Возврат ВосстановитьСсылкуОбмена(Значение);
        ИначеЕсли Тег = "enum" Тогда
            Возврат ВосстановитьПеречисление(Значение["metadata"], Значение["value"]);
        ИначеЕсли Тег <> Неопределено Тогда
            ВызватьИсключение "Unsupported parameter type.";
        КонецЕсли;
        Результат = Новый Соответствие;
        Для Каждого Пара Из Значение Цикл
            Результат.Вставить(Пара.Ключ, ВосстановитьЗначениеОбмена(Пара.Значение));
        КонецЦикла;
        Возврат Результат;
    ИначеЕсли Вид = Тип("Массив") Тогда
        Результат = Новый Массив;
        Для Каждого Элемент Из Значение Цикл
            Результат.Добавить(ВосстановитьЗначениеОбмена(Элемент));
        КонецЦикла;
        Возврат Результат;
    КонецЕсли;
    Возврат Значение;
КонецФункции

&НаСервереБезКонтекста
Функция ТипСсылкиОбмена(Мета)
    Части = СтрРазделить(Мета.ПолноеИмя(), ".");
    Если Части.Количество() = 2 И СтрРазделить(
        "Справочник,Документ,ПланВидовХарактеристик,ПланСчетов,ПланВидовРасчета,ПланОбмена,БизнесПроцесс,Задача", ",").Найти(Части[0]) <> Неопределено Тогда
        Возврат Тип(Части[0] + "Ссылка." + Части[1]);
    ИначеЕсли Части.Количество() = 4 И Части[0] = "ВнешнийИсточникДанных" И Части[2] = "Таблица" Тогда
        Возврат Тип("ВнешнийИсточникДанныхТаблицаСсылка." + Части[1] + "." + Части[3]);
    ИначеЕсли Части.Количество() = 6 И Части[0] = "ВнешнийИсточникДанных" И Части[2] = "Куб" И Части[4] = "ТаблицаИзмерения" Тогда
        Возврат Тип("ВнешнийИсточникДанныхКубТаблицаИзмеренияСсылка." + Части[1] + "." + Части[3] + "." + Части[5]);
    КонецЕсли;
    ВызватьИсключение "Metadata does not define a supported reference type: " + Мета.ПолноеИмя();
КонецФункции

&НаСервереБезКонтекста
Функция ВосстановитьСсылкуОбмена(Знач Описание)
    Имя = Описание["metadata"];
    Мета = Метаданные.НайтиПоПолномуИмени(Имя);
    Если Мета = Неопределено Тогда ВызватьИсключение "Unknown reference metadata."; КонецЕсли;
    Если Описание["point"] <> Неопределено Тогда
        Если Лев(Мета.ПолноеИмя(), 14) <> "БизнесПроцесс." Тогда
            ВызватьИсключение "A route point requires business-process metadata.";
        КонецЕсли;
        Возврат БизнесПроцессы[Мета.Имя].ТочкиМаршрута[Описание["point"]];
    КонецЕсли;
    ТипСсылки = ТипСсылкиОбмена(Мета);
    Если Лев(Мета.ПолноеИмя(), 22) = "ВнешнийИсточникДанных." Тогда
        // У внешней ссылки может быть составной ключ, а не UUID. Сохраняем его
        // штатным сериализатором 1С; читаем только заранее определенный тип ссылки.
        Читатель = Новый ЧтениеXML;
        Читатель.УстановитьСтроку(Описание["xml"]);
        ОжидаемыйТипXML = СериализаторXDTO.XMLТип(ТипСсылки);
        Пока Читатель.Прочитать() Цикл
            Если Читатель.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда Прервать; КонецЕсли;
        КонецЦикла;
        // Явный тип в ПрочитатьXML допускает преобразование XML другой ссылки.
        // Проверяем исходный тип, чтобы не переадресовать ссылку в другую таблицу.
        Если Читатель.ЛокальноеИмя <> ОжидаемыйТипXML.ИмяТипа
            Или Читатель.URIПространстваИмен <> ОжидаемыйТипXML.URIПространстваИмен Тогда
            Читатель.Закрыть();
            ВызватьИсключение "Reference XML does not match its metadata.";
        КонецЕсли;
        Ссылка = СериализаторXDTO.ПрочитатьXML(Читатель, ТипСсылки);
        Читатель.Закрыть();
        Если ТипЗнч(Ссылка) <> ТипСсылки Тогда ВызватьИсключение "Reference XML has a different type."; КонецЕсли;
        Возврат Ссылка;
    КонецЕсли;
    Возврат XMLЗначение(ТипСсылки, Описание["uuid"]);
КонецФункции

&НаСервереБезКонтекста
Функция ВосстановитьПеречисление(Знач Имя, Знач Значение)
    Мета = Метаданные.НайтиПоПолномуИмени(Имя);
    Если Мета = Неопределено Или Лев(Имя, 13) <> "Перечисление." Тогда
        ВызватьИсключение "Unknown enumeration metadata.";
    КонецЕсли;
    Если Значение = "" Тогда Возврат Перечисления[Мета.Имя].ПустаяСсылка(); КонецЕсли;
    Возврат Перечисления[Мета.Имя][Значение];
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПодготовитьЗначение(Знач Значение)
    Вид = ТипЗнч(Значение);
    Если Вид = Тип("Null") Тогда
        // ЗаписатьJSON поддерживает Неопределено как JSON null, но не Null запроса.
        Возврат Неопределено;
    ИначеЕсли Вид = Тип("Неопределено") Или Вид = Тип("Строка") Или Вид = Тип("Число") Или Вид = Тип("Булево") Тогда
        Возврат Значение;
    ИначеЕсли Вид = Тип("Дата") Тогда
        Результат = Новый Соответствие;
        Результат.Вставить("$type", "date");
        Результат.Вставить("value", XMLСтрока(Значение));
        Возврат Результат;
    ИначеЕсли Вид = Тип("Массив") Или Вид = Тип("ФиксированныйМассив") Тогда
        Результат = Новый Массив;
        Для Каждого Элемент Из Значение Цикл
            Результат.Добавить(ПодготовитьЗначение(Элемент));
        КонецЦикла;
        Возврат Результат;
    ИначеЕсли Вид = Тип("Структура") Или Вид = Тип("Соответствие") Или Вид = Тип("ФиксированнаяСтруктура") Или Вид = Тип("ФиксированноеСоответствие") Тогда
        Результат = Новый Соответствие;
        Для Каждого Пара Из Значение Цикл
            Если ТипЗнч(Пара.Ключ) <> Тип("Строка") Тогда ВызватьИсключение "JSON object keys must be strings."; КонецЕсли;
            Результат.Вставить(Пара.Ключ, ПодготовитьЗначение(Пара.Значение));
        КонецЦикла;
        Возврат Результат;
    КонецЕсли;
    Возврат ПодготовитьСсылку(Значение);
КонецФункции

&НаСервереБезКонтекста
Функция ПодготовитьСсылку(Знач Значение)
    ТипXML = XMLТипЗнч(Значение);
    Если ТипXML <> Неопределено Тогда
        ЧастиТипа = СтрРазделить(ТипXML.ИмяТипа, ".");
        Если ЧастиТипа[0] = "BusinessProcessRoutePointRef" И ЧастиТипа.Количество() = 2 Тогда
            МетаПроцесса = Метаданные.БизнесПроцессы[ЧастиТипа[1]];
            Результат = Новый Соответствие;
            Результат.Вставить("$type", "ref");
            Результат.Вставить("metadata", МетаПроцесса.ПолноеИмя());
            Результат.Вставить("point", Значение.Имя);
            Результат.Вставить("presentation", Строка(Значение));
            Возврат Результат;
        КонецЕсли;
    КонецЕсли;
    Мета = Метаданные.НайтиПоТипу(ТипЗнч(Значение));
    Если Мета = Неопределено Тогда ВызватьИсключение "Unsupported result type: " + Строка(ТипЗнч(Значение)); КонецЕсли;
    Имя = Мета.ПолноеИмя();
    Если Лев(Имя, 13) = "Перечисление." Тогда
        ИмяЗначения = "";
        Если Не Значение.Пустая() Тогда
            Индекс = Перечисления[Мета.Имя].Индекс(Значение);
            ИмяЗначения = Мета.ЗначенияПеречисления[Индекс].Имя;
        КонецЕсли;
        Результат = Новый Соответствие;
        Результат.Вставить("$type", "enum");
        Результат.Вставить("metadata", Имя);
        Результат.Вставить("value", ИмяЗначения);
        Результат.Вставить("presentation", Строка(Значение));
        Возврат Результат;
    КонецЕсли;
    Если ТипЗнч(Значение) <> ТипСсылкиОбмена(Мета) Тогда
        ВызватьИсключение "Unsupported result type: " + Строка(ТипЗнч(Значение));
    КонецЕсли;
    Результат = Новый Соответствие;
    Результат.Вставить("$type", "ref");
    Результат.Вставить("metadata", Имя);
    Если Лев(Имя, 22) = "ВнешнийИсточникДанных." Тогда
        Писатель = Новый ЗаписьXML;
        Писатель.УстановитьСтроку();
        СериализаторXDTO.ЗаписатьXML(Писатель, Значение);
        Результат.Вставить("xml", Писатель.Закрыть());
        // Получение представления может требовать недоступного внешнего сервера.
        Попытка
            ПредставлениеСсылки = Строка(Значение);
        Исключение
            ПредставлениеСсылки = Неопределено;
        КонецПопытки;
        Результат.Вставить("presentation", ПредставлениеСсылки);
    Иначе
        Результат.Вставить("uuid", XMLСтрока(Значение));
        Результат.Вставить("presentation", Строка(Значение));
    КонецЕсли;
    Возврат Результат;
КонецФункции

